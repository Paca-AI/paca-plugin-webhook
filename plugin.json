{
  "id": "com.paca.webhook",
  "displayName": "Webhooks",
  "description": "Sends HTTP webhooks to a URL of your choice when task activity happens in a project.",
  "version": "0.1.9",
  "minCoreVersion": "v0.13.3",
  "permissions": ["db.read", "db.write", "events.subscribe"],
  "customPermissions": [
    {
      "key": "webhook.manage",
      "label": "Manage webhooks",
      "description": "View, create, edit, delete, and test outgoing webhooks for this project.",
      "scope": "project"
    }
  ],
  "backend": {
    "allowedConfigKeys": ["ENCRYPTION_KEY", "PUBLIC_URL"],
    "allowedOutboundDomains": ["*"],
    "sensitiveFields": {
      "webhooks": ["secret_enc"]
    },
    "eventSubscriptions": [
      "task.created",
      "task.updated",
      "task.deleted",
      "task.attachment.added",
      "task.attachment.removed",
      "comment",
      "task.link.added",
      "task.link.removed",
      "agent.session.started",
      "task.comment.added",
      "task.comment.updated",
      "task.comment.deleted"
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/webhooks",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["webhook.manage"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/webhooks",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["webhook.manage"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/webhooks/:webhookId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["webhook.manage"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/webhooks/:webhookId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["webhook.manage"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/webhooks/:webhookId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["webhook.manage"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/webhooks/:webhookId/deliveries",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["webhook.manage"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/webhooks/:webhookId/test",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["webhook.manage"]
          }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.webhook/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.settings.tab",
        "component": "WebhookSettingsTab",
        "label": "Webhooks",
        "order": 110,
        "requiredPermission": "webhook.manage"
      }
    ]
  }
}
